{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    // Replaces the list in $app/tsconfig, so "$app/types" has to be repeated.
    "types": ["$app/types", "@webgpu/types"]
  },
  // TypeScript does not merge these with a parent config either.
  "include": ["src", "tests", "*"],
  "exclude": ["src/service-worker"]
}
