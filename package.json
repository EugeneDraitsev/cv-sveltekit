{
  "name": "cv-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && bun run lint:svelte",
    "lint:ox": "oxlint .",
    "lint:svelte": "eslint --no-error-on-unmatched-pattern \"src/**/*.svelte\" \"src/**/*.svelte.ts\" \"src/**/*.svelte.js\"",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test:unit && bun run build"
  },
  "dependencies": {
    "@threlte/core": "^8.5.16",
    "@threlte/extras": "^9.21.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "svelte-tweakpane-ui": "^1.5.18",
    "three": "^0.185.1"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@typescript/native": "npm:typescript@7",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.1",
    "typescript": "~6",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-glsl": "^1.6.0",
    "vitest": "^4.1.10"
  }
}
