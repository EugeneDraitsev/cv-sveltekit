{
  "name": "cv-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cv:pdf": "node cv/build.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test:unit && bun run build"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "typegpu": "0.12.10"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/adapter-vercel": "^7.0.4",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@webgpu/types": "^0.1.74",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
